<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KitDeCampo.Pages.SummaryPage"
    Title="Summary / Resumen"
    BackgroundColor="#3B0B11">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Title Header -->
            <Label
                Text="Service Summary / Resumen del Servicio"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#D4AF37" />

            <!-- Card Container -->
            <Border
                BackgroundColor="#54121B"
                Stroke="#D4AF37"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="15">
                <Editor
                    x:Name="SummaryEditor"
                    IsReadOnly="True"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="280"
                    FontSize="14"
                    TextColor="#FFFFFF"
                    BackgroundColor="#54121B" />
            </Border>

            <!-- Buttons -->
            <VerticalStackLayout Spacing="12">
                <Button
                    Text="Copy Summary / Copiar Resumen"
                    Clicked="CopySummary_Clicked"
                    BackgroundColor="#D4AF37"
                    TextColor="#200508"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50" />

                <Button
                    Text="Share Summary / Compartir Resumen"
                    Clicked="ShareSummary_Clicked"
                    BackgroundColor="#54121B"
                    BorderColor="#D4AF37"
                    BorderWidth="1"
                    TextColor="#D4AF37"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
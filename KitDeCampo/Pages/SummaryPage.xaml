<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KitDeCampo.Pages.SummaryPage"
    Title="Service Summary"
    BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Title Header -->
            <Label
                Text="Service Summary"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#1E293B" />

            <!-- Card Container for Summary -->
            <Border
                BackgroundColor="White"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="0"
                Padding="15">
                <Editor
                    x:Name="SummaryEditor"
                    IsReadOnly="True"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="280"
                    FontSize="14"
                    TextColor="#334155"
                    BackgroundColor="Transparent" />
            </Border>

            <!-- Buttons -->
            <VerticalStackLayout Spacing="12">
                <Button
                    Text="Copy Summary"
                    Clicked="CopySummary_Clicked"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50" />

                <Button
                    Text="Share Summary"
                    Clicked="ShareSummary_Clicked"
                    BackgroundColor="#0F172A"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KitDeCampo.Pages.VisitsPage"
    Title="Visits / Visitas"
    BackgroundColor="#F4F6F8">

    <Grid Padding="20" RowDefinitions="Auto,*,Auto" RowSpacing="15">

        <!-- Encabezado Bilingüe -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label
                Text="Field Tech / Kit de Campo"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#1E293B" />

            <Label
                Text="Service Visits / Visitas de Servicio"
                FontSize="14"
                TextColor="#64748B" />
        </VerticalStackLayout>

        <!-- Lista de Visitas -->
        <CollectionView
            Grid.Row="1"
            x:Name="VisitsCollection"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    Spacing="8">

                    <Label
                        Text="No visits yet / Sin visitas aún"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="#64748B" />

                    <Label
                        Text="Create your first service visit / Crea tu primera visita"
                        FontSize="13"
                        HorizontalOptions="Center"
                        TextColor="#94A3B8" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="16"
                        Margin="0,6"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        BackgroundColor="White">

                        <!-- Evento para tocar la tarjeta y ver la visita -->
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVisitSelected" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                            <!-- Nombre del Cliente -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding NombreCliente}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#0F172A" />

                            <!-- Fecha -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding Fecha, StringFormat='{0:MMM dd, yyyy}'}"
                                FontSize="13"
                                TextColor="#64748B" />

                            <!-- Tiempo Total -->
                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="{Binding TiempoTotal, StringFormat='Total: {0} min'}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#2563EB" />

                            <!-- Badge de Estado -->
                            <Border
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Padding="10,5"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                BackgroundColor="#E2E8F0">
                                <Label
                                    Text="{Binding Estado}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#334155" />
                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Botón para Agregar Nueva Visita -->
        <Button
            Grid.Row="2"
            Text="+ New Visit / Nueva Visita"
            Clicked="NewVisit_Clicked"
            BackgroundColor="#2563EB"
            TextColor="White"
            FontAttributes="Bold"
            CornerRadius="10"
            HeightRequest="52" />

    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KitDeCampo.Pages.VisitsPage"
    Title="Visits / Visitas"
    BackgroundColor="#3B0B11">

    <Grid Padding="20" RowDefinitions="Auto,*,Auto" RowSpacing="15">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label
                Text="Field Tech / Kit de Campo"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#D4AF37" />

            <Label
                Text="Service Visits / Visitas de Servicio"
                FontSize="14"
                TextColor="#E6C665" />
        </VerticalStackLayout>

        <!-- Visits List -->
        <CollectionView
            Grid.Row="1"
            x:Name="VisitsCollection"
            SelectionMode="None">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label
                        Text="No visits yet / Sin visitas aún"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="#E6C665" />

                    <Label
                        Text="Create your first service visit / Crea tu primera visita"
                        FontSize="13"
                        HorizontalOptions="Center"
                        TextColor="#D4AF37" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Padding="16"
                        Margin="0,6"
                        StrokeShape="RoundRectangle 12"
                        Stroke="#D4AF37"
                        StrokeThickness="1"
                        BackgroundColor="#54121B">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnVisitSelected" />
                        </Border.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                            <Label
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding NombreCliente}"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#FFFFFF" />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding Fecha, StringFormat='{0:MMM dd, yyyy}'}"
                                FontSize="13"
                                TextColor="#E6C665" />

                            <Label
                                Grid.Row="2"
                                Grid.Column="0"
                                Text="{Binding TiempoTotal, StringFormat='Total: {0} min'}"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="#D4AF37" />

                            <Border
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Padding="10,5"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#D4AF37"
                                StrokeThickness="1"
                                BackgroundColor="#3B0B11">
                                <Label
                                    Text="{Binding Estado}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#D4AF37" />
                            </Border>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- New Visit Button -->
        <Button
            Grid.Row="2"
            Text="+ New Visit / Nueva Visita"
            Clicked="NewVisit_Clicked"
            BackgroundColor="#D4AF37"
            TextColor="#200508"
            FontAttributes="Bold"
            CornerRadius="10"
            HeightRequest="52" />

    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KitDeCampo.Pages.TasksPage"
    Title="Tasks / Tareas"
    BackgroundColor="#3B0B11">

    <Grid Padding="20" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="15">

        <!-- Header Card -->
        <Border
            Grid.Row="0"
            Padding="16"
            StrokeShape="RoundRectangle 12"
            Stroke="#D4AF37"
            StrokeThickness="1"
            BackgroundColor="#54121B">
            <VerticalStackLayout Spacing="6">
                <Label
                    x:Name="CustomerLabel"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#FFFFFF" />

                <HorizontalStackLayout Spacing="15">
                    <Label
                        x:Name="StatusLabel"
                        FontSize="14"
                        FontAttributes="Bold"
                        TextColor="#D4AF37" />

                    <Label
                        x:Name="TimeLabel"
                        FontSize="14"
                        TextColor="#E6C665" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Tasks List -->
        <CollectionView Grid.Row="1" x:Name="TasksCollection">

            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="6">
                    <Label
                        Text="No tasks yet / Sin tareas aún"
                        FontSize="18"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="#E6C665" />

                    <Label
                        Text="Add a task below / Agrega una tarea abajo"
                        FontSize="13"
                        HorizontalOptions="Center"
                        TextColor="#D4AF37" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,4"
                        Padding="10,6"
                        StrokeShape="RoundRectangle 10"
                        Stroke="#D4AF37"
                        StrokeThickness="0.5"
                        BackgroundColor="#54121B">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                            <CheckBox
                                Grid.Column="0"
                                IsChecked="{Binding IsDone}"
                                CheckedChanged="Task_CheckedChanged"
                                Color="#D4AF37" />

                            <Label
                                Grid.Column="1"
                                Text="{Binding Descripcion}"
                                VerticalOptions="Center"
                                FontSize="15"
                                TextColor="#FFFFFF" />

                            <Border
                                Grid.Column="2"
                                Padding="8,4"
                                StrokeShape="RoundRectangle 6"
                                StrokeThickness="0"
                                BackgroundColor="#3B0B11"
                                VerticalOptions="Center">
                                <Label
                                    Text="{Binding Minutos, StringFormat='{0} min'}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="#D4AF37" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!-- Form Input -->
        <Grid Grid.Row="2" ColumnDefinitions="*,80,Auto" ColumnSpacing="8">
            <Border
                Grid.Column="0"
                Padding="10,0"
                StrokeShape="RoundRectangle 8"
                Stroke="#D4AF37"
                StrokeThickness="1"
                BackgroundColor="#54121B">
                <Entry
                    x:Name="TaskEntry"
                    Placeholder="New task / Tarea"
                    PlaceholderColor="#A38550"
                    FontSize="14"
                    TextColor="#FFFFFF" />
            </Border>

            <Border
                Grid.Column="1"
                Padding="8,0"
                StrokeShape="RoundRectangle 8"
                Stroke="#D4AF37"
                StrokeThickness="1"
                BackgroundColor="#54121B">
                <Entry
                    x:Name="MinutesEntry"
                    Placeholder="Min"
                    PlaceholderColor="#A38550"
                    Keyboard="Numeric"
                    HorizontalTextAlignment="Center"
                    FontSize="14"
                    TextColor="#FFFFFF" />
            </Border>

            <Button
                Grid.Column="2"
                Text="Add / +"
                Clicked="AddTask_Clicked"
                BackgroundColor="#D4AF37"
                TextColor="#200508"
                FontAttributes="Bold"
                CornerRadius="8"
                HeightRequest="45" />
        </Grid>

        <!-- Summary Button -->
        <Button
            Grid.Row="3"
            Text="View Summary / Ver Resumen"
            Clicked="Summary_Clicked"
            BackgroundColor="#54121B"
            BorderColor="#D4AF37"
            BorderWidth="1"
            TextColor="#D4AF37"
            FontAttributes="Bold"
            CornerRadius="10"
            HeightRequest="52" />

    </Grid>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KitDeCampo.Pages.NewVisitPage"
    Title="New Visit / Nueva Visita"
    BackgroundColor="#F4F6F8">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Title Header -->
            <Label
                Text="New Service Visit / Nueva Visita"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#1E293B" />

            <!-- Customer Name Section -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Customer Name / Nombre del Cliente"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#334155" />

                <Border
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    Padding="10,2">
                    <Entry
                        x:Name="CustomerEntry"
                        Placeholder="e.g. ACME Corp"
                        TextColor="#0F172A" />
                </Border>
            </VerticalStackLayout>

            <!-- Visit Date Section -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Visit Date / Fecha de Visita"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#334155" />

                <Border
                    BackgroundColor="White"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="0"
                    Padding="10,2">
                    <DatePicker
                        x:Name="VisitDatePicker"
                        TextColor="#0F172A" />
                </Border>
            </VerticalStackLayout>

            <!-- Submit Button -->
            <Button
                Text="Create Visit / Crear Visita"
                Clicked="CreateVisit_Clicked"
                BackgroundColor="#2563EB"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="52"
                Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
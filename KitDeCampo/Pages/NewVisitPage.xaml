<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KitDeCampo.Pages.NewVisitPage"
    Title="New Visit / Nueva Visita"
    BackgroundColor="#3B0B11">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label
                Text="New Service Visit / Nueva Visita"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="#D4AF37" />

            <!-- Customer -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Customer Name / Nombre del Cliente"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#E6C665" />

                <Border
                    BackgroundColor="#54121B"
                    Stroke="#D4AF37"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="10,2">
                    <Entry
                        x:Name="CustomerEntry"
                        Placeholder="e.g. ACME Corp"
                        PlaceholderColor="#A38550"
                        TextColor="#FFFFFF" />
                </Border>
            </VerticalStackLayout>

            <!-- Date -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Visit Date / Fecha de Visita"
                    FontSize="14"
                    FontAttributes="Bold"
                    TextColor="#E6C665" />

                <Border
                    BackgroundColor="#54121B"
                    Stroke="#D4AF37"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="10,2">
                    <DatePicker
                        x:Name="VisitDatePicker"
                        TextColor="#FFFFFF" />
                </Border>
            </VerticalStackLayout>

            <!-- Submit Button -->
            <Button
                Text="Create Visit / Crear Visita"
                Clicked="CreateVisit_Clicked"
                BackgroundColor="#D4AF37"
                TextColor="#200508"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="52"
                Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>